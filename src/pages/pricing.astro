---
import Layout from '../layouts/Layout.astro';
import { buttonVariants } from '../components/ui/Button';
import { excludedFirstPhaseMarkets, priceGrid } from '../lib/product-config';

const priceRows = Object.entries(priceGrid);
const formatAmount = (amount: number, currency: string) => `${amount.toLocaleString('en-US', { maximumFractionDigits: 2 })} ${currency}`;
---

<Layout title="Prices — Dear Someone" description="Annual Dear Someone prices by currency, including the founding cohort rate.">
  <header class="border-b border-border">
    <div class="shell flex min-h-20 items-center justify-between gap-6">
      <a class="font-serif text-[1.35rem] tracking-[-0.025em] no-underline" href="/" aria-label="Dear Someone, home">Dear Someone</a>
      <a class="text-sm text-muted-foreground underline underline-offset-4 hover:text-foreground" href="/launch/">← Service overview</a>
    </div>
  </header>

  <main class="shell max-w-5xl py-16 sm:py-24 lg:py-32">
    <p class="eyebrow mb-6">Annual membership</p>
    <h1 class="section-title balance max-w-3xl">One clear price, shown in the currency you use.</h1>
    <p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground">The first number is the full annual price. The second is the founding-cohort price for the first three paid years after the free season. Local prices are fixed amounts, not a live exchange-rate conversion.</p>

    <div class="mt-14 overflow-x-auto border-y border-border">
      <table class="w-full min-w-[38rem] border-collapse text-left text-sm">
        <caption class="sr-only">Annual Dear Someone prices by currency</caption>
        <thead>
          <tr class="border-b border-border text-xs uppercase tracking-[0.12em] text-muted-foreground">
            <th class="px-4 py-4 font-medium">Currency</th>
            <th class="px-4 py-4 font-medium">Full price</th>
            <th class="px-4 py-4 font-medium">Founding price · years 1–3</th>
            <th class="px-4 py-4 font-medium">Availability</th>
          </tr>
        </thead>
        <tbody>
          {priceRows.map(([currency, prices]) => {
            const unavailable = currency === 'CNY' && excludedFirstPhaseMarkets.includes('CN');
            return (
              <tr class="border-b border-border last:border-0">
                <th scope="row" class="px-4 py-4 font-medium">{currency}</th>
                <td class="px-4 py-4">{formatAmount(prices.full, currency)}</td>
                <td class="px-4 py-4">{formatAmount(prices.founding, currency)}</td>
                <td class="px-4 py-4 text-muted-foreground">{unavailable ? 'Planned — China not in phase one' : 'Planned for supported markets'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <p class="mt-6 max-w-2xl text-sm leading-6 text-muted-foreground">Ukraine has a separate declared-access path with a 100% promotion for the life of the subscription. The UAH row above is the reference price, not the amount due on that path.</p>
    <a class={buttonVariants({ variant: 'outline', size: 'small' }) + ' mt-8'} href="/launch/">Back to Dear Someone</a>
  </main>
</Layout>
