---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/Button';
import { fullAnnualPrice } from '../../lib/product-config';

const steps = [
  ['Write from your inbox', 'Send a plain-text email to write@dearsomeone.net.'],
  ['One reader receives it', 'We choose one person who can read your language.'],
  ['Leave room for a reply', 'They can answer, acknowledge the letter, or let it end there.'],
];
---

<Layout title="Dear Someone is open" description="One letter. One reader. Maybe a reply. Dear Someone is now open for correspondence.">
  <header class="border-b border-border">
    <div class="shell flex min-h-20 items-center justify-between gap-6">
      <a class="font-serif text-[1.35rem] tracking-[-0.025em] no-underline" href="/" aria-label="Dear Someone, home">Dear Someone</a>
      <nav class="hidden items-center gap-8 text-sm text-muted-foreground md:flex" aria-label="Main navigation">
        <a class="underline-offset-4 hover:text-foreground hover:underline" href="#how-it-works">How it works</a>
        <a class="underline-offset-4 hover:text-foreground hover:underline" href="/member/">Account</a>
      </nav>
      <a class={buttonVariants({ variant: 'outline', size: 'small' })} href="/sign-in/">Sign in</a>
    </div>
  </header>

  <main id="main-content">
    <section class="border-b border-border py-20 sm:py-28 lg:py-36">
      <div class="shell grid items-end gap-16 lg:grid-cols-[1.08fr_0.78fr] lg:gap-20">
        <div>
          <p class="eyebrow mb-7">The service is open</p>
          <h1 class="display balance">An email that is only for you.</h1>
          <p class="mt-8 max-w-xl text-lg leading-8 text-muted-foreground sm:text-xl">Before your inbox became a marketplace, an email was just someone writing to you. Dear Someone brings that back.</p>
          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a class={buttonVariants({ size: 'large' })} href="/sign-in/?mode=signup&plan=free">Start free</a>
            <a class={buttonVariants({ variant: 'quiet', size: 'large' })} href="/blog/">Read the journal</a>
          </div>
        </div>
        <div class="border border-border bg-surface px-6 py-8 sm:px-8 sm:py-10">
          <p class="eyebrow mb-4">Your membership</p>
          <p class="font-serif text-4xl tracking-[-0.04em]">Free to start</p>
          <p class="mt-4 leading-7 text-muted-foreground">New members open one correspondence every three months. Switch to annual membership whenever you want for {fullAnnualPrice.label}; replies inside an open correspondence never use either allowance.</p>
          <p class="mt-7 border-t border-border pt-5 text-sm leading-6 text-muted-foreground">Founding waitlist members begin with 8 weeks of the daily opening pace, then choose Free or annual membership. Their first three paid years use the founding price for their market.</p>
          <a class="mt-5 inline-block text-sm underline underline-offset-4" href="/pricing/">See local prices →</a>
        </div>
      </div>
    </section>

    <section class="border-b border-border py-20 sm:py-28" id="how-it-works">
      <div class="shell">
        <p class="eyebrow mb-5">A simple exchange</p>
        <h2 class="section-title">The platform does less<br />so the letter can do more.</h2>
        <ol class="mt-14 border-t border-border">
          {steps.map(([title, body], index) => (
            <li class="grid gap-4 border-b border-border py-8 md:grid-cols-[5rem_0.65fr_1fr] md:gap-10 md:py-10">
              <span class="eyebrow pt-1" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="m-0 font-serif text-2xl font-normal tracking-[-0.025em]">{title}</h3>
              <p class="m-0 max-w-xl leading-7 text-muted-foreground">{body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="py-20 sm:py-28">
      <div class="shell grid gap-10 md:grid-cols-2 md:gap-20">
        <div>
          <p class="eyebrow mb-5">Your private area</p>
          <h2 class="section-title">The practical side stays small.</h2>
        </div>
        <div class="self-end">
          <p class="text-lg leading-8 text-muted-foreground">Your letters stay in your inbox. The private area is for membership, preferences, consents, privacy requests and account deletion.</p>
          <a class="mt-6 inline-block text-sm underline underline-offset-4" href="/member">Open the member area →</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-border py-8">
    <div class="shell flex flex-col gap-5 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p class="m-0">© 2026 Dear Someone</p>
      <div class="flex gap-5">
        <a class="underline-offset-4 hover:text-foreground hover:underline" href="/blog/">Journal</a>
        <a class="underline-offset-4 hover:text-foreground hover:underline" href="/privacy">Privacy</a>
        <a class="underline-offset-4 hover:text-foreground hover:underline" href="/terms">Terms</a>
      </div>
    </div>
  </footer>
</Layout>
