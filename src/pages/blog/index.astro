---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/Button';
import { blogArticles } from '../../lib/blog';

const themes = [
  {
    label: 'Context',
    title: 'What an inbox can still be for',
    body: 'Notes on attention, correspondence, and the small human things that get lost in a commercial inbox.',
  },
  {
    label: 'Comparisons',
    title: 'Choosing a slower way to meet',
    body: 'A clear look at pen pals, anonymous letters, social feeds, and why the mechanism changes the feeling.',
  },
  {
    label: 'Practical guides',
    title: 'How to write to someone new',
    body: 'Gentle prompts for beginning a letter without needing a performance, a perfect story, or an answer.',
  },
  {
    label: 'Building in public',
    title: 'Making the room carefully',
    body: 'Transparent notes about matching, delivery, moderation, privacy, and the choices behind One Reader.',
  },
];
---

<Layout title="Journal — One Reader" description="Notes on correspondence, attention, and building One Reader in public.">
  <header class="border-b border-border">
    <div class="shell flex min-h-20 items-center justify-between gap-6">
      <a class="font-serif text-[1.35rem] tracking-[-0.025em] no-underline" href="/" aria-label="One Reader, home">One Reader</a>
      <a class="text-sm text-muted-foreground underline underline-offset-4 hover:text-foreground" href="/">← Back home</a>
    </div>
  </header>

  <main class="shell py-16 sm:py-24">
    <div class="max-w-3xl">
      <p class="eyebrow mb-5">The One Reader journal</p>
      <h1 class="section-title balance">Before your inbox became a marketplace, an email was just someone writing to you.</h1>
      <p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground">This is where we will write about correspondence, attention, and the decisions involved in making a quiet place for strangers to meet.</p>
    </div>

    <section class="mt-16 border-y border-border py-8 sm:py-10" aria-labelledby="latest-heading">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow mb-4">Latest note</p>
          <h2 id="latest-heading" class="font-serif text-3xl font-normal tracking-[-0.03em]">{blogArticles[0].title}</h2>
          <p class="mt-3 max-w-2xl leading-7 text-muted-foreground">{blogArticles[0].description}</p>
        </div>
        <a class={buttonVariants({ variant: 'outline', size: 'small' })} href={`/blog/${blogArticles[0].slug}/`}>Read the note →</a>
      </div>
    </section>

    <div class="mt-16 grid gap-x-12 gap-y-0 border-t border-border md:grid-cols-2">
      {themes.map((theme) => (
        <article class="border-b border-border py-8 sm:py-10">
          <p class="eyebrow mb-4">{theme.label}</p>
          <h2 class="font-serif text-3xl font-normal tracking-[-0.03em]">{theme.title}</h2>
          <p class="mt-4 max-w-md leading-7 text-muted-foreground">{theme.body}</p>
          <p class="mt-6 text-sm text-muted-foreground">First notes are being prepared.</p>
        </article>
      ))}
    </div>

    <aside class="mt-16 flex flex-col gap-5 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="m-0 max-w-xl text-sm leading-6 text-muted-foreground">The journal will live on the main domain, alongside the product. No separate publication or third-party subdomain.</p>
      <a class={buttonVariants({ variant: 'outline', size: 'small' })} href="/waitlist/">Join the waitlist</a>
    </aside>
  </main>
</Layout>
