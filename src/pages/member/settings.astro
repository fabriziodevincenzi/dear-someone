---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/Button';
---

<Layout title="Account settings — Dear Someone" description="Manage your Dear Someone account and membership.">
  <header class="border-b border-border">
    <div class="shell flex min-h-20 items-center justify-between gap-6">
      <a class="font-serif text-[1.35rem] tracking-[-0.025em] no-underline" href="/" aria-label="Dear Someone, home">Dear Someone</a>
      <a class="text-sm text-muted-foreground underline underline-offset-4 hover:text-foreground" href="/member">← Your account</a>
    </div>
  </header>

  <main class="shell max-w-4xl py-14 sm:py-20">
    <p class="eyebrow mb-5">Account</p>
    <h1 class="section-title">The practical details.</h1>

    <section class="mt-12 grid gap-10 border-t border-border py-8 md:grid-cols-[0.7fr_1.3fr]" aria-labelledby="account-heading">
      <div>
        <h2 id="account-heading" class="font-serif text-2xl font-normal">Your account</h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">The minimum information needed to keep your correspondence private.</p>
      </div>
      <dl class="grid gap-5 text-sm sm:grid-cols-2">
        <div><dt class="text-muted-foreground">Email</dt><dd class="mt-1" data-account-email>you@example.com</dd><a class="mt-2 inline-block text-xs underline underline-offset-4" href="/sign-in/?mode=change-email">Change email</a></div>
        <div><dt class="text-muted-foreground">Age</dt><dd class="mt-1">18+</dd></div>
        <div><dt class="text-muted-foreground">Writing languages</dt><dd class="mt-1">English · fluent</dd></div>
        <div><dt class="text-muted-foreground">Reading languages</dt><dd class="mt-1">English · fluent</dd></div>
      </dl>
    </section>

    <section class="grid gap-10 border-t border-border py-8 md:grid-cols-[0.7fr_1.3fr]" aria-labelledby="language-heading">
      <div>
        <h2 id="language-heading" class="font-serif text-2xl font-normal">Your language profile</h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">Matching uses the languages you can write and read, not interests or public profiles.</p>
      </div>
      <form class="grid gap-6" data-language-profile>
        <label class="grid gap-2 text-sm" for="mother-tongue">
          <span class="text-muted-foreground">Mother tongue</span>
          <select id="mother-tongue" name="motherTongue" class="min-h-11 rounded-[var(--radius-control)] border border-input bg-transparent px-3">
            <option>English</option>
            <option>Ukrainian</option>
            <option>Spanish</option>
            <option>French</option>
            <option>German</option>
          </select>
        </label>

        <fieldset class="grid gap-4 border-t border-border pt-5">
          <legend class="text-sm text-muted-foreground">Languages for letters</legend>
          <div class="grid gap-4 sm:grid-cols-[1fr_10rem_auto_auto] sm:items-end">
            <label class="grid gap-2 text-sm" for="language-english"><span>Language</span><select id="language-english" name="language" class="min-h-11 rounded-[var(--radius-control)] border border-input bg-transparent px-3"><option>English</option><option>Ukrainian</option><option>Spanish</option></select></label>
            <label class="grid gap-2 text-sm" for="language-level"><span>Level</span><select id="language-level" name="level" class="min-h-11 rounded-[var(--radius-control)] border border-input bg-transparent px-3"><option>Fluent</option><option>Native</option><option>Good</option><option>Basic</option></select></label>
            <label class="flex min-h-11 items-center gap-2 text-sm"><input type="checkbox" name="willingToWrite" checked /> Write</label>
            <label class="flex min-h-11 items-center gap-2 text-sm"><input type="checkbox" name="willingToRead" checked /> Read</label>
          </div>
          <p class="m-0 text-xs leading-5 text-muted-foreground">A language is eligible for matching from “Good” upward. “Read” and “Write” stay separate so the pool reflects what you actually want to receive.</p>
        </fieldset>

        <label class="flex items-start gap-3 text-sm leading-6"><input class="mt-1" type="checkbox" name="availableToReceive" checked /> <span>I am available to receive a new letter.</span></label>
        <button class="w-fit border-b border-foreground pb-1 text-sm" type="submit">Save language profile</button>
        <p class="hidden text-sm text-accent" data-language-note>Saved in this local prototype. Production will persist this profile in the member record.</p>
      </form>
    </section>

    <section id="membership" class="grid gap-10 border-t border-border py-8 md:grid-cols-[0.7fr_1.3fr]" aria-labelledby="plan-heading">
      <div>
        <h2 id="plan-heading" class="font-serif text-2xl font-normal">Membership</h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">Your current access and the actions connected to your subscription.</p>
      </div>
      <div>
        <p class="m-0 font-serif text-2xl">Free pace</p>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">One new correspondence every three months. Annual membership opens one new correspondence every 24 hours; the price is shown for your market before payment.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a class={buttonVariants({ variant: 'outline', size: 'small' })} href="/sign-in/?mode=signup&plan=annual">Open payment options</a>
          <a class="inline-flex min-h-9 items-center border-b border-border px-1 text-sm underline-offset-4 hover:border-foreground" href="/sign-in/?mode=cancel">Cancel membership</a>
          <a class="inline-flex min-h-9 items-center border-b border-border px-1 text-sm underline-offset-4 hover:border-foreground" href="/sign-in/?mode=refund">Request a refund</a>
        </div>
        <p class="mt-4 text-xs leading-5 text-muted-foreground">Refund requests within the first 14 days will follow the applicable consumer rules and payment terms. These actions are placeholders in this local prototype.</p>
      </div>
    </section>

    <section id="consents" class="grid gap-10 border-t border-border py-8 md:grid-cols-[0.7fr_1.3fr]" aria-labelledby="consents-heading">
      <div>
        <h2 id="consents-heading" class="font-serif text-2xl font-normal">Consents and emails</h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">Operational messages keep the service working. Optional Journal messages are your choice.</p>
      </div>
      <div class="grid gap-5 text-sm leading-6">
        <label class="flex items-start gap-3"><input class="mt-1" type="checkbox" name="journalOptIn" /> <span><strong class="font-medium">Journal and product news</strong><br /><span class="text-muted-foreground">Occasional notes about Dear Someone. Optional and revocable at any time.</span></span></label>
        <p class="m-0 border-t border-border pt-5 text-muted-foreground"><strong class="font-medium text-foreground">Service emails</strong><br />Magic links, delivery notices, account security and subscription messages are necessary to provide the service and are not marketing consent.</p>
        <button class="w-fit border-b border-foreground pb-1 text-sm" type="button">Save communication choices</button>
      </div>
    </section>

    <section id="privacy" class="grid gap-10 border-t border-border py-8 md:grid-cols-[0.7fr_1.3fr]" aria-labelledby="privacy-heading">
      <div>
        <h2 id="privacy-heading" class="font-serif text-2xl font-normal">Privacy requests</h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">You can ask what data we hold or request a portable copy.</p>
      </div>
      <div class="flex flex-wrap items-start gap-3">
        <a class={buttonVariants({ variant: 'outline', size: 'small' })} href="/privacy#rights">Request my data</a>
        <a class="inline-flex min-h-9 items-center border-b border-border px-1 text-sm underline-offset-4 hover:border-foreground" href="/privacy">Read the privacy notice</a>
      </div>
    </section>

    <section class="mt-4 grid gap-10 border-t border-accent py-8 md:grid-cols-[0.7fr_1.3fr]" aria-labelledby="delete-heading">
      <div>
        <h2 id="delete-heading" class="font-serif text-2xl font-normal">Delete your account</h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">This is permanent. In production, letters will follow the retention policy and block relationships will be removed when the account is closed.</p>
      </div>
      <form data-delete-account>
        <button class="inline-flex min-h-11 items-center justify-center rounded-[var(--radius-control)] border border-accent px-5 text-sm font-medium text-accent transition-colors hover:bg-accent hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" type="submit">Delete account and data</button>
        <p class="mt-4 hidden text-sm leading-6 text-accent" data-delete-note>Deletion is not connected in this local prototype. The production flow will require a final confirmation before removing data.</p>
      </form>
    </section>
  </main>

  <script>
    import { supabase } from '../../lib/supabase';

    const accountEmail = document.querySelector<HTMLElement>('[data-account-email]');
    const { data: sessionData } = supabase ? await supabase.auth.getSession() : { data: { session: null } };
    if (supabase && !sessionData.session) {
      window.location.assign('/sign-in/');
    } else if (sessionData.session && accountEmail) {
      accountEmail.textContent = sessionData.session.user.email || 'your verified email';
    }

    const deleteForm = document.querySelector('[data-delete-account]');
    const deleteNote = document.querySelector('[data-delete-note]');

    deleteForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      deleteNote?.classList.remove('hidden');
    });

    const languageForm = document.querySelector('[data-language-profile]');
    const languageNote = document.querySelector('[data-language-note]');

    languageForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      languageNote?.classList.remove('hidden');
    });
  </script>
</Layout>
