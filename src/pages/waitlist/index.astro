---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/Button';
import { serviceIsOpen } from '../../lib/product-config';

const openService = serviceIsOpen();
---

<Layout title="One Reader is open" description="One Reader is open for free correspondence.">
  <main class="shell min-h-[82vh] py-16 sm:py-24 lg:py-32">
    <a class="text-sm text-muted-foreground underline underline-offset-4" href="/">← Back home</a>
    <div class="mx-auto max-w-2xl pt-24 text-center sm:pt-32">
      {openService ? (
        <>
          <p class="eyebrow mb-6">The service is open</p>
          <h1 class="section-title balance">There is no wait.</h1>
          <p class="mx-auto mt-8 max-w-xl text-lg leading-8 text-muted-foreground">Create a free account and write one first letter. After that, you can always receive letters and reply; annual membership lets you open a new correspondence every 24 hours.</p>
          <p class="mt-8 font-serif text-2xl italic">Think of something you would like to say to someone new.</p>
        </>
      ) : (
        <></>
      )}
      <div class="mt-10 flex justify-center">
        <a class={buttonVariants({ variant: openService ? 'primary' : 'outline' })} href={openService ? '/launch/' : '/'}>{openService ? 'Enter One Reader' : 'Return to One Reader'}</a>
      </div>
    </div>
  </main>
</Layout>
