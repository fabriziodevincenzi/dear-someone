---
import Layout from '../layouts/Layout.astro';
import EmailPreview from '../components/EmailPreview.astro';
import { Button, buttonVariants } from '../components/ui/Button';
import { Input } from '../components/ui/Input';
import { serviceIsOpen, waitlistConfig, waitlistCountIsPublic } from '../lib/product-config';

const perspectives = [
  {
    label: 'When you write',
    intro: 'You begin the exchange from the inbox you already use.',
    steps: [
      {
        number: '01',
        title: 'Write from your inbox',
        body: 'Send a plain-text letter from the email address you already use. No app, profile, or public post.',
      },
      {
        number: '02',
        title: 'A compatible reader is chosen at random',
        body: 'We choose one available member who can read your language. There is no catalogue to browse and no matching by interests. Your real email address stays hidden.',
      },
    ],
  },
  {
    label: 'When you receive',
    intro: 'The same quiet channel can bring a letter back to you.',
    steps: [
      {
        number: '03',
        title: 'A letter may find you too',
        body: 'When another member is matched with you, the letter arrives in your normal inbox from a private alias. You can read it without creating a profile or exposing your address.',
      },
      {
        number: '04',
        title: 'Reply, stop, or let it end',
        body: 'You can answer in your own words, choose to stop the correspondence, or leave room for silence. None of those choices is a score.',
      },
    ],
  },
];

const timelineStages = [
  {
    label: 'Now',
    eyebrow: 'Waitlist open',
    title: 'The waitlist fills',
    body: 'We keep the first group small enough that every letter has a real chance of finding a reader. The waitlist closes at the launch threshold.',
  },
  {
    label: 'When the room is ready',
    eyebrow: 'Founding group first',
    title: 'The service opens',
    body: "We'll announce the opening date by email. Waitlist members go first, writing up to once a day for 8 weeks — free. After that, they move to a special founding price for their first three paid years. Anyone joining after them can start free too, or go straight to annual.",
  },
  {
    label: 'After 8 weeks',
    eyebrow: 'Choose your plan',
    title: 'Free stays light. Annual opens every day.',
    body: 'When the season ends, founding members choose: stay on Free — one correspondence every 3 months, always — or move to annual, at the founding price for their first three paid years, with one new opening every 24 hours.',
  },
];

const publicWaitlistCount = waitlistCountIsPublic();
const openService = serviceIsOpen();
const currentTimelineStage = openService ? 1 : 0;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout turnstileSiteKey={turnstileSiteKey}>
  <header class="border-b border-border">
    <div class="shell flex min-h-20 items-center justify-between gap-6">
      <a class="font-serif text-[1.35rem] tracking-[-0.025em] no-underline" href="/" aria-label="One Reader, home">
        One Reader
      </a>
      <nav class="hidden items-center gap-8 text-sm text-muted-foreground md:flex" aria-label="Main navigation">
        <a class="underline-offset-4 hover:text-foreground hover:underline" href="#how-it-works">How it works</a>
        <a class="underline-offset-4 hover:text-foreground hover:underline" href="#timeline">Timeline</a>
        {openService && <a class="underline-offset-4 hover:text-foreground hover:underline" href="#membership">Membership</a>}
      </nav>
      <a class={buttonVariants({ variant: 'outline', size: 'small' })} href="#waitlist">Join the waitlist</a>
    </div>
  </header>

  <main id="main-content">
    <section class="border-b border-border py-16 sm:py-24 lg:py-32">
      <div class="shell grid items-end gap-16 lg:grid-cols-[1.08fr_0.78fr] lg:gap-20">
        <div>
          <p class="eyebrow mb-7">{openService ? 'One Reader is open' : 'Founding season · waitlist open'}</p>
          <h1 class="display balance">One letter. One reader. Maybe a reply.</h1>
          <p class="mt-8 max-w-xl text-lg leading-8 text-muted-foreground sm:text-xl">
            Write to someone you do not know, from the quiet of your own inbox. No profiles to perform for. No feed to keep up with.
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a class={buttonVariants({ size: 'large' })} href="#waitlist">Join the waitlist</a>
            <a class={buttonVariants({ variant: 'quiet', size: 'large' })} href="#how-it-works">See how it works</a>
          </div>
          <p class="mt-5 max-w-md text-sm text-muted-foreground">
            {openService
              ? 'New members start on the free pace and can move to annual membership whenever they want. Waitlist members begin with eight weeks of the daily opening pace.'
              : 'Join the first group now and we’ll email you when the room is ready.'}
          </p>
        </div>

        <EmailPreview />
      </div>
    </section>

    <section class="border-b border-border py-20 sm:py-28" id="how-it-works">
      <div class="shell">
        <div class="grid gap-8 md:grid-cols-[0.75fr_1.25fr] md:gap-20">
          <div>
            <p class="eyebrow mb-5">How it works</p>
            <h2 class="section-title balance">A small ritual, not another platform.</h2>
          </div>
          <p class="max-w-2xl self-end text-lg leading-8 text-muted-foreground">
            Every member lives both sides of the exchange: you write first, and a letter may find you too. One Reader carries the letter and protects both addresses.
          </p>
        </div>

        <div class="mt-16 grid gap-12">
          {perspectives.map((perspective) => (
            <section class="border-t border-border pt-6" aria-labelledby={`perspective-${perspective.label.toLowerCase().replaceAll(' ', '-')}`}>
              <div>
                <div>
                  <div>
                    <p class="eyebrow mb-1 text-accent">{perspective.label}</p>
                    <h3 id={`perspective-${perspective.label.toLowerCase().replaceAll(' ', '-')}`} class="m-0 max-w-sm font-serif text-2xl font-normal tracking-[-0.025em]">{perspective.intro}</h3>
                  </div>
                  <ol class="mt-8 border-t border-border pt-4">
                    {perspective.steps.map((step) => (
                      <li class="mb-8 grid gap-2 last:mb-0 sm:grid-cols-[2.5rem_1fr] sm:gap-3">
                        <span class="eyebrow pt-1" aria-hidden="true">{step.number}</span>
                        <div>
                          <h4 class="m-0 font-serif text-xl font-normal tracking-[-0.025em]">{step.title}</h4>
                          <p class="mt-1 m-0 max-w-xl leading-7 text-muted-foreground">{step.body}</p>
                        </div>
                      </li>
                    ))}
                  </ol>
                </div>
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-border py-20 sm:py-28" id="timeline">
      <div class="shell">
        <div class="grid gap-8 md:grid-cols-[0.75fr_1.25fr] md:gap-20">
          <div>
            <p class="eyebrow mb-5">The first season</p>
            <h2 class="section-title balance">A small beginning, in three stages.</h2>
          </div>
          <p class="max-w-2xl self-end text-lg leading-8 text-muted-foreground">
            We are not asking you to wait for an undefined product. This is the path from the first group to a correspondence service you can join at your own pace.
          </p>
        </div>

        <div class="relative mt-16">
          <div class="absolute bottom-0 left-4 top-0 border-l border-accent/40 md:bottom-auto md:left-0 md:right-0 md:top-4 md:border-l-0 md:border-t" aria-hidden="true"></div>
          <div class="relative grid gap-12 md:grid-cols-3 md:gap-10">
            {timelineStages.map((stage, index) => {
              const isCurrent = index === currentTimelineStage;
              return (
                <article class="relative pl-12 md:pl-0 md:pt-12" data-current={isCurrent ? 'true' : 'false'}>
                  <span class:list={[
                    'absolute left-0 top-0 z-10 flex h-8 w-8 items-center justify-center rounded-full border-2 text-xs transition-colors md:left-0',
                    isCurrent ? 'border-accent bg-accent text-primary-foreground' : 'border-accent bg-background text-accent',
                  ]} aria-label={isCurrent ? 'Current stage' : `Stage ${index + 1}`}>
                    {index + 1}
                  </span>
                  <p class="eyebrow mb-3">{stage.label}</p>
                  <p class="mb-5 text-xs uppercase tracking-[0.12em] text-accent">{isCurrent ? 'Current stage · ' : ''}{stage.eyebrow}</p>
                  <h3 class="m-0 font-serif text-2xl font-normal tracking-[-0.025em]">{stage.title}</h3>
                  <p class="mt-4 m-0 leading-7 text-muted-foreground">{stage.body}</p>
                </article>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    {openService && <section class="border-b border-border py-20 sm:py-28" id="membership">
      <div class="shell grid gap-16 lg:grid-cols-2 lg:gap-24">
        <div>
          <p class="eyebrow mb-5">Membership</p>
          <h2 class="section-title">Choose your<br />pace of writing.</h2>
          <p class="mt-8 max-w-lg text-lg leading-8 text-muted-foreground">
            Start gently, or make a year of room for letters. Both plans keep the same private aliases, careful delivery, moderation, and no public profile.
          </p>
        </div>
        <div class="grid gap-8 border-t border-border pt-8 lg:mt-2 sm:grid-cols-2 sm:gap-10">
          <div>
            <p class="eyebrow mb-4">Free</p>
            <h3 class="font-serif text-3xl font-normal tracking-[-0.03em]">One correspondence every three months.</h3>
            <p class="mt-4 text-sm leading-6 text-muted-foreground">The date follows your own sign-up day. Replies and open conversations continue without a cap.</p>
          </div>
          <div class="border-t border-border pt-6 sm:border-l sm:border-t-0 sm:pl-8 sm:pt-0">
            <p class="eyebrow mb-4 text-accent">Member</p>
            <h3 class="font-serif text-3xl font-normal tracking-[-0.03em]">€18 <span class="text-base text-muted-foreground">/ year</span></h3>
            <p class="mt-4 text-sm leading-6 text-muted-foreground">One new correspondence every 24 hours. Founding members begin with an 8-week free season and keep their special price for the first three paid years.</p>
          </div>
        </div>
      </div>
    </section>}

    <section class="py-20 sm:py-28" id="waitlist">
      <div class="shell grid gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-24">
        <div>
          <p class="eyebrow mb-5">{openService ? 'The service is open' : 'The waitlist is open'}</p>
          <h2 class="section-title balance">{openService ? 'Start with a free correspondence.' : 'Come in with the first small group.'}</h2>
          <p class="mt-7 max-w-lg leading-7 text-muted-foreground">
            {openService
              ? 'New members can start free with one new correspondence every three months, then switch to annual membership at any time. There is no application and no selection.'
              : 'We are opening slowly so every first letter has a real chance of finding its reader. There is no application and no selection.'}
          </p>
          {!openService && <p class="mt-5 max-w-lg leading-7 text-muted-foreground">
            Joining the waitlist is free registration for One Reader — not just a notification list. When the service opens, your account will let you write up to once a day for 8 weeks at no cost. After that, you can stay on Free with one new correspondence every three months, or join the annual membership at a special founding price for your first three paid years.
          </p>}
          <p class="mt-5 text-sm text-muted-foreground" aria-live="polite">
            {publicWaitlistCount
              ? `${waitlistConfig.count.toLocaleString('en-US')} people are waiting to write.`
              : 'The waitlist is open — we will share the number once the first small group has formed.'}
          </p>
        </div>
        {openService ? (
          <div class="self-end border-t border-border pt-8">
            <p class="m-0 text-lg leading-8">The first group is inside. New members can begin on Free now.</p>
            <a class={buttonVariants({ size: 'large' }) + ' mt-6'} href="/launch/">Enter One Reader</a>
          </div>
        ) : (
          <form class="relative self-end overflow-hidden border border-accent/60 bg-surface p-6 sm:p-8" data-waitlist-form>
            <div data-waitlist-fields>
              <p class="eyebrow mb-5">Register your place</p>
              <h3 class="max-w-md font-serif text-3xl font-normal leading-tight tracking-[-0.03em] sm:text-4xl">Give the first letter somewhere to arrive.</h3>
              <p class="mt-5 max-w-md leading-7 text-muted-foreground">Create your One Reader account and reserve a place in the first group. We’ll verify your email before saving it.</p>
              <div class="mt-8">
                <label class="mb-2 block text-sm font-medium" for="email">Email address</label>
                <div class="grid gap-3 sm:grid-cols-[1fr_auto]">
                  <Input id="email" name="email" type="email" autoComplete="email" placeholder="you@example.com" required aria-describedby="waitlist-privacy" className="bg-background" />
                  <Button type="submit" size="large">Register for the waitlist</Button>
                </div>
              </div>
              <label class="mt-6 flex items-start gap-3 text-sm leading-6">
                <input class="mt-1" type="checkbox" name="termsAccepted" required />
                <span>I have read and accept the <a class="underline underline-offset-4" href="/terms">Terms of Service</a> and acknowledge the <a class="underline underline-offset-4" href="/privacy">Privacy notice</a>.</span>
              </label>
              <label class="mt-6 flex items-start gap-3 text-sm leading-6 text-muted-foreground">
                <input class="mt-1" type="checkbox" name="journalOptIn" value="yes" />
                <span>Send me occasional Journal notes and product news too. This is optional.</span>
              </label>
              {turnstileSiteKey && (
                <div class="mt-6" data-turnstile-widget data-sitekey={turnstileSiteKey} aria-label="Security check"></div>
              )}
              <input class="absolute -left-[9999px] h-px w-px opacity-0" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <p class="mt-4 text-xs leading-5 text-muted-foreground" id="waitlist-privacy" data-waitlist-note>
                We’ll use your address for the waitlist and the operational emails needed to manage it. You can leave at any time.
              </p>
            </div>
            <div class="hidden" data-waitlist-success aria-live="polite">
              <p class="eyebrow mb-5">You’re registered</p>
              <h3 class="max-w-md font-serif text-3xl font-normal leading-tight tracking-[-0.03em] sm:text-4xl" data-waitlist-success-title>Your place is saved.</h3>
              <p class="mt-5 max-w-md leading-7 text-muted-foreground" data-waitlist-success-copy>Check your inbox for the confirmation link. We’ll write when the first small group is ready.</p>
              <a class="mt-7 inline-flex text-sm underline underline-offset-4 hover:text-foreground" href="/sign-in/">Already registered? Open your account</a>
            </div>
          </form>
        )}
      </div>
    </section>
  </main>

  <footer class="border-t border-border py-8">
    <div class="shell flex flex-col gap-5 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p class="m-0">© 2026 One Reader</p>
      <p class="m-0 font-serif text-base italic text-foreground/75">Someone who pays attention without asking you to perform.</p>
      <div class="flex gap-5">
        <a class="underline-offset-4 hover:text-foreground hover:underline" href="/journal/">Journal</a>
        <a class="underline-offset-4 hover:text-foreground hover:underline" href="/privacy">Privacy</a>
        <a class="underline-offset-4 hover:text-foreground hover:underline" href="/terms">Terms</a>
      </div>
    </div>
  </footer>

  <script>
    import { supabase } from '../lib/supabase';

    const form = document.querySelector<HTMLFormElement>('[data-waitlist-form]');
    const note = document.querySelector<HTMLElement>('[data-waitlist-note]');
    const fields = document.querySelector<HTMLElement>('[data-waitlist-fields]');
    const success = document.querySelector<HTMLElement>('[data-waitlist-success]');
    const successTitle = document.querySelector<HTMLElement>('[data-waitlist-success-title]');
    const successCopy = document.querySelector<HTMLElement>('[data-waitlist-success-copy]');
    const captchaWidget = document.querySelector<HTMLElement>('[data-turnstile-widget]');
    let captchaToken: string | null = null;
    let captchaWidgetId: string | null = null;
    const intentKey = 'dear-someone:signup-intent';
    const lastWaitlistEmailKey = 'dear-someone:waitlist-email';

    const showNote = (message: string, error = false) => {
      if (!note) return;
      note.textContent = message;
      note.classList.toggle('text-destructive', error);
      note.classList.toggle('text-muted-foreground', !error);
    };

    const showSuccess = (alreadyRegistered = false) => {
      if (fields) fields.classList.add('hidden');
      if (success) success.classList.remove('hidden');
      if (alreadyRegistered) {
        if (successTitle) successTitle.textContent = 'You were already on the waitlist.';
        if (successCopy) successCopy.textContent = 'Your place is still active. Use the link in your inbox, or open your account if you need to sign in.';
      }
    };

    type TurnstileApi = {
      render: (element: HTMLElement, options: {
        sitekey: string;
        callback: (token: string) => void;
        'expired-callback': () => void;
        'error-callback': () => void;
      }) => string;
      reset: (widgetId?: string) => void;
    };

    const renderCaptcha = () => {
      const turnstile = (window as Window & { turnstile?: TurnstileApi }).turnstile;
      const sitekey = captchaWidget?.dataset.sitekey;
      if (!turnstile || !captchaWidget || !sitekey || captchaWidget.dataset.rendered) return;
      captchaWidgetId = turnstile.render(captchaWidget, {
        sitekey,
        callback: (token) => { captchaToken = token; },
        'expired-callback': () => { captchaToken = null; },
        'error-callback': () => { captchaToken = null; showNote('The security check could not be completed. Please try again.', true); },
      });
      captchaWidget.dataset.rendered = 'true';
    };

    window.addEventListener('load', renderCaptcha, { once: true });
    renderCaptcha();

    const finishWaitlistSignup = async (session: { access_token: string; user?: { email?: string; user_metadata?: Record<string, unknown> } }) => {
      if (!supabase) return;
      const rawIntent = window.localStorage.getItem(intentKey);
      let intent: Record<string, unknown>;
      if (!rawIntent) {
        const metadata = session.user?.user_metadata;
        if (metadata?.source !== 'waitlist') return;
        intent = {
          source: 'waitlist',
          plan: 'free',
          countryCode: metadata.market_country ?? null,
          marketCurrency: metadata.market_currency ?? null,
          languageCode: metadata.language_code ?? navigator.language ?? 'en',
          journalOptIn: metadata.journal_opt_in === true,
          termsAccepted: metadata.terms_accepted === true,
          privacyAcknowledged: metadata.privacy_acknowledged === true,
        };
      } else {
        try {
          intent = JSON.parse(rawIntent);
        } catch {
          window.localStorage.removeItem(intentKey);
          return;
        }
      }
      const { data: completion, error } = await supabase.functions.invoke('complete-signup', {
        body: intent,
        headers: { Authorization: `Bearer ${session.access_token}` },
      });
      if (error) {
        showNote('Your email is verified, but we could not finish saving your place. Please try again.', true);
        return;
      }
      window.localStorage.removeItem(intentKey);
      window.localStorage.setItem(lastWaitlistEmailKey, String(session.user?.email || ''));
      showSuccess(completion?.alreadyWaitlisted === true);
    };

    supabase?.auth.onAuthStateChange((event, session) => {
      if (session && (event === 'SIGNED_IN' || event === 'INITIAL_SESSION')) {
        if (window.location.hash.includes('access_token')) {
          window.history.replaceState({}, document.title, '/');
        }
        window.setTimeout(() => void finishWaitlistSignup(session), 0);
      }
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const email = String(data.get('email') || '').trim().toLowerCase();
      const honeypot = String(data.get('website') || '').trim();
      if (!email || !supabase) {
        showNote('The waitlist is not connected right now. Please try again shortly.', true);
        return;
      }

      if (honeypot) return;

      if (captchaWidget && !captchaToken) {
        showNote('Please complete the security check before registering.', true);
        return;
      }

      const lastSubmittedAt = Number(window.localStorage.getItem('dear-someone:waitlist-last-submitted') || '0');
      if (Date.now() - lastSubmittedAt < 60_000) {
        showNote('A confirmation link was just requested. Please wait a moment before trying again.', true);
        return;
      }

      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitButton) submitButton.disabled = true;
      showNote('Sending your confirmation link…');
      window.localStorage.setItem(intentKey, JSON.stringify({
        source: 'waitlist',
        plan: 'free',
        countryCode: (navigator.language.split('-')[1] || '').toUpperCase() || null,
        languageCode: navigator.language || 'en',
        journalOptIn: data.get('journalOptIn') === 'yes',
        termsAccepted: data.get('termsAccepted') === 'on',
        privacyAcknowledged: data.get('termsAccepted') === 'on',
      }));
      window.localStorage.setItem('dear-someone:waitlist-last-submitted', String(Date.now()));

      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: {
          shouldCreateUser: true,
          emailRedirectTo: `${window.location.origin}/`,
          captchaToken: captchaToken ?? undefined,
          data: {
            source: 'waitlist',
            market_country: (navigator.language.split('-')[1] || '').toUpperCase() || null,
            language_code: navigator.language || 'en',
            journal_opt_in: data.get('journalOptIn') === 'yes',
            terms_accepted: data.get('termsAccepted') === 'on',
            privacy_acknowledged: data.get('termsAccepted') === 'on',
          },
        },
      });
      if (submitButton) submitButton.disabled = false;
      if (error) {
        captchaToken = null;
        const turnstile = (window as Window & { turnstile?: TurnstileApi }).turnstile;
        if (turnstile && captchaWidgetId) turnstile.reset(captchaWidgetId);
        window.localStorage.removeItem(intentKey);
        showNote(error.message || 'We could not send the link. Please try again.', true);
        return;
      }
      showNote('Check your inbox to confirm your registration.');
    });
  </script>
</Layout>
