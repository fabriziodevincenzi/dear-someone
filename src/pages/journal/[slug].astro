---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/Button';
import JournalFooter from '../../components/JournalFooter.astro';
import { getJournalEntries, getJournalDate, getJournalKey, getJournalSlug, formatJournalDate, getJournalLocale, type JournalEntry } from '../../lib/journal';
import { siteLocales } from '../../lib/i18n';

export async function getStaticPaths() {
  const entries = await getJournalEntries('en');
  return entries.map((entry) => ({ params: { slug: getJournalSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props as { entry: JournalEntry };
const allEntries: JournalEntry[] = (await Promise.all(siteLocales.map((locale) => getJournalEntries(locale)))).flat();
const { Content } = await render(entry);
const slug = getJournalSlug(entry);
const publishedAt = getJournalDate(entry);
const articleUrl = new URL(`/journal/${slug}/`, Astro.site ?? Astro.url.origin);
const socialImage = new URL(`/og/${slug}.png`, Astro.site ?? Astro.url.origin).toString();
const alternateLocales = Object.fromEntries(
  allEntries
    .filter((candidate) => getJournalKey(candidate) === getJournalKey(entry))
    .map((candidate) => {
      const candidateLocale = getJournalLocale(candidate);
      return [candidateLocale, new URL(`/${candidateLocale === 'en' ? '' : `${candidateLocale}/`}journal/${getJournalSlug(candidate)}/`, Astro.site ?? Astro.url.origin).toString()];
    }),
);
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data['meta-description'],
  datePublished: publishedAt,
  ...(entry.data.updatedAt ? { dateModified: entry.data.updatedAt } : {}),
  inLanguage: getJournalLocale(entry),
  image: [socialImage],
  author: { '@type': 'Organization', name: entry.data.author, url: new URL('/', Astro.site ?? Astro.url.origin).toString() },
  publisher: { '@type': 'Organization', name: 'One Reader', url: new URL('/', Astro.site ?? Astro.url.origin).toString() },
  mainEntityOfPage: articleUrl.toString(),
};
---

<Layout title={`${entry.data.title} — One Reader`} description={entry.data['meta-description']} ogType="article" locale="en" alternateLocales={alternateLocales} socialImage={socialImage} socialImageAlt={entry.data.title}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />
  <header class="border-b border-border">
    <div class="shell flex min-h-20 items-center justify-between gap-6">
      <a class="font-serif text-[1.35rem] tracking-[-0.025em] no-underline" href="/" aria-label="One Reader, home">One Reader</a>
      <a class={buttonVariants({ variant: 'outline', size: 'small' })} href="/">Write to someone</a>
    </div>
  </header>

  <main id="main-content" class="shell py-16 sm:py-24 lg:py-32">
    <header class="mx-auto max-w-[42rem]">
      <a class="eyebrow mb-6 inline-block text-accent underline decoration-accent/50 underline-offset-4 hover:text-foreground" href="/journal/">Journal</a>
      <h1 class="section-title balance">{entry.data.title}</h1>
      <p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground">{entry.data['meta-description']}</p>
      <p class="mt-5 text-sm text-muted-foreground">
        <time datetime={publishedAt}>{formatJournalDate(publishedAt)}</time> · {entry.data.readingTime}
      </p>
    </header>

    <article class="prose-journal mx-auto mt-14 max-w-[42rem] border-t border-border pt-10 sm:mt-16 sm:pt-12">
      <Content />
      <div class="mt-14 flex flex-wrap items-center justify-between gap-5 border-t border-border pt-6">
        <a class="text-sm text-muted-foreground underline decoration-border underline-offset-4 hover:text-foreground" href="/journal/">Back to Journal</a>
        <a class="text-sm font-medium text-accent underline decoration-accent/50 underline-offset-4 hover:text-foreground" href="/">Write to someone</a>
      </div>
    </article>
  </main>
  <JournalFooter />
</Layout>
