---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/Button';
import { blogArticles } from '../../lib/blog';

const [latestArticle, ...earlierArticles] = blogArticles;
---

<Layout title="Journal — One Reader" description="Notes on writing to strangers, paying attention, and finding a way to begin.">
  <header class="border-b border-border">
    <div class="shell flex min-h-20 items-center justify-between gap-6">
      <a class="font-serif text-[1.35rem] tracking-[-0.025em] no-underline" href="/" aria-label="One Reader, home">One Reader</a>
      <a class={buttonVariants({ variant: 'outline', size: 'small' })} href="mailto:write@onereader.co">Write to someone →</a>
    </div>
  </header>

  <main id="main-content" class="shell py-16 sm:py-24 lg:py-32">
    <div class="max-w-3xl">
      <p class="eyebrow mb-5 text-accent">Journal</p>
      <h1 class="section-title balance max-w-3xl">Notes on writing to strangers, paying attention, and finding a way to begin.</h1>
      <p class="mt-8 max-w-2xl text-lg leading-8 text-muted-foreground">
        Thoughts on correspondence, attention, and the strange, hopeful work of beginning a conversation with someone you do not know.
      </p>
    </div>

    <section class="mt-16 max-w-3xl border-y border-border py-8 sm:mt-20 sm:py-10" aria-labelledby="featured-heading">
      <p class="eyebrow mb-4 text-accent">Featured note</p>
      <h2 id="featured-heading" class="font-serif text-3xl font-normal tracking-[-0.03em] sm:text-4xl">{latestArticle.title}</h2>
      <p class="mt-3 max-w-2xl leading-7 text-muted-foreground">{latestArticle.description}</p>
      <a class="mt-6 inline-block text-sm font-medium text-accent underline decoration-accent/50 underline-offset-4 hover:text-foreground" href={`/journal/${latestArticle.slug}/`}>Read the note →</a>
    </section>

    {earlierArticles.length > 0 && <section class="mt-16 max-w-3xl" aria-labelledby="earlier-heading">
      <p id="earlier-heading" class="eyebrow mb-5">Earlier notes</p>
      <div class="border-t border-border">
        {earlierArticles.map((article) => (
          <a class="flex items-baseline justify-between gap-6 border-b border-border py-5 no-underline transition-colors hover:text-accent" href={`/journal/${article.slug}/`}>
            <span class="font-serif text-2xl font-normal tracking-[-0.025em]">{article.title}</span>
            <time class="shrink-0 text-sm text-muted-foreground" datetime={article.publishedAt}>{article.publishedAt}</time>
          </a>
        ))}
      </div>
    </section>}
  </main>
</Layout>
