---
import Layout from '../../layouts/Layout.astro';
import { Button } from '../../components/ui/Button';
import { Input } from '../../components/ui/Input';

const isChangeEmail = new URL(Astro.request.url).searchParams.get('mode') === 'change-email';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout title={isChangeEmail ? 'Change email — One Reader' : 'Sign in — One Reader'} description="Sign in to your private One Reader account with a one-time email link." turnstileSiteKey={turnstileSiteKey} indexable={false}>
  <header class="border-b border-border">
    <div class="shell flex min-h-20 items-center justify-between gap-6">
      <a class="font-serif text-[1.35rem] tracking-[-0.025em] no-underline" href="/" aria-label="One Reader, home">One Reader</a>
    </div>
  </header>

  <main class="shell min-h-[82vh] max-w-xl py-20 sm:py-28 lg:py-36">
    <div class="mx-auto max-w-lg">
      <p class="eyebrow mb-6">{isChangeEmail ? 'Account details' : 'Sign in'}</p>
      <h1 class="section-title balance">{isChangeEmail ? 'Confirm a new address.' : 'Welcome back.'}</h1>
      <p class="mt-8 text-lg leading-8 text-muted-foreground">
        {isChangeEmail
          ? 'Enter the new email address for your One Reader account. We will send a confirmation link before changing it.'
          : 'Enter your email and we’ll send a one-time sign-in link. There is no password to remember.'}
      </p>

      <form class="mt-12" data-magic-link-form>
        <div data-sign-in-fields>
          <label class="mb-2 block text-sm font-medium" for="sign-in-email">Email address</label>
          <div class="grid gap-3 sm:grid-cols-[1fr_auto]">
            <Input id="sign-in-email" name="email" type="email" autoComplete="email" placeholder="you@example.com" required />
            <Button type="submit" size="large" data-submit-label>{isChangeEmail ? 'Send confirmation' : 'Send sign-in link'}</Button>
          </div>
        </div>
        <p class="mt-4 text-xs leading-5 text-muted-foreground" data-flow-helper>
          {isChangeEmail ? 'Your current address stays active until you confirm the new one.' : 'The link is single-use and expires shortly.'}
        </p>
        {!isChangeEmail && turnstileSiteKey && (
          <div class="mt-6 hidden rounded-sm bg-muted/40 p-5" data-sign-in-captcha-step>
            <div class="w-full max-w-full" data-sign-in-turnstile data-sitekey={turnstileSiteKey} aria-label="Security check"></div>
          </div>
        )}
        <p class="mt-5 hidden text-sm leading-6 text-accent" data-magic-link-note aria-live="polite"></p>
      </form>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  const isChangeEmail = new URLSearchParams(window.location.search).get('mode') === 'change-email';
  const form = document.querySelector<HTMLFormElement>('[data-magic-link-form]')!;
  const fields = document.querySelector<HTMLElement>('[data-sign-in-fields]');
  const flowHelper = document.querySelector<HTMLElement>('[data-flow-helper]');
  const captchaStep = document.querySelector<HTMLElement>('[data-sign-in-captcha-step]');
  const captchaWidget = document.querySelector<HTMLElement>('[data-sign-in-turnstile]');
  const note = document.querySelector<HTMLElement>('[data-magic-link-note]');
  type TurnstileApi = {
    render: (element: HTMLElement, options: Record<string, unknown>) => string;
    reset: (widgetId: string) => void;
  };
  let captchaWidgetId: string | null = null;
  let captchaToken: string | null = null;
  let pendingEmail: string | null = null;
  const showNote = (message: string, error = false) => {
    if (!note) return;
    note.textContent = message;
    note.classList.remove('hidden', 'text-accent', 'text-destructive');
    note.classList.add(error ? 'text-destructive' : 'text-accent');
  };

  const showLeadNote = () => {
    if (!note) return;
    note.textContent = 'There is no account attached to this address yet. ';
    const link = document.createElement('a');
    link.href = '/#start-free';
    link.textContent = 'Start free from the home page';
    link.className = 'underline underline-offset-4';
    note.append(link);
    note.classList.remove('hidden', 'text-accent', 'text-destructive');
    note.classList.add('text-accent');
  };

  const resetCaptcha = () => {
    captchaToken = null;
    const turnstile = (window as Window & { turnstile?: TurnstileApi }).turnstile;
    if (turnstile && captchaWidgetId) turnstile.reset(captchaWidgetId);
  };

  const restoreFields = () => {
    fields?.classList.remove('hidden');
    flowHelper?.classList.remove('hidden');
    captchaStep?.classList.add('hidden');
    pendingEmail = null;
  };

  const showSuccessState = (message: string) => {
    fields?.classList.add('hidden');
    flowHelper?.classList.add('hidden');
    captchaStep?.classList.add('hidden');
    showNote(message);
  };

  const sendSignInLink = async () => {
    if (!pendingEmail || !supabase) return;
    const email = pendingEmail;
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitButton) submitButton.disabled = true;
    showNote('Sending your sign-in link…');

    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: {
        shouldCreateUser: false,
        emailRedirectTo: `${window.location.origin}/sign-in/`,
        captchaToken: captchaToken ?? undefined,
      },
    });
    if (submitButton) submitButton.disabled = false;
    if (error) {
      const isUnknownAccount = /signups? not allowed|user not found|no user|user_not_found/i.test(error.message);
      if (isUnknownAccount) {
        const { error: leadError } = await supabase.from('leads').insert({ email_address: email, source: 'sign_in' });
        resetCaptcha();
        restoreFields();
        if (leadError) {
          showNote('We could not complete the request. Please try again in a moment.', true);
          return;
        }
        showLeadNote();
        return;
      }
      resetCaptcha();
      restoreFields();
      showNote('We could not send a sign-in link. Please try again in a moment.', true);
      return;
    }
    resetCaptcha();
    showSuccessState('Your sign-in link is on its way. Check your inbox — it is single-use and will open your private area.');
  };

  const renderCaptcha = () => {
    const turnstile = (window as Window & { turnstile?: TurnstileApi }).turnstile;
    const sitekey = captchaWidget?.dataset.sitekey;
    if (!turnstile || !captchaWidget || !sitekey || captchaWidget.dataset.rendered) return;
    captchaWidgetId = turnstile.render(captchaWidget, {
      sitekey,
      theme: 'light',
      size: 'flexible',
      appearance: 'always',
      language: 'en',
      callback: (token: string) => {
        captchaToken = token;
        void sendSignInLink();
      },
      'expired-callback': resetCaptcha,
      'error-callback': () => {
        resetCaptcha();
        restoreFields();
        showNote('The security check could not be completed. Please try again.', true);
      },
    });
    captchaWidget.dataset.rendered = 'true';
  };

  supabase?.auth.onAuthStateChange((event, session) => {
    const hasCallbackToken = window.location.hash.includes('access_token');
    if (session && (event === 'SIGNED_IN' || (event === 'INITIAL_SESSION' && hasCallbackToken))) {
      if (hasCallbackToken) window.history.replaceState({}, document.title, '/sign-in/');
      if (!isChangeEmail) window.location.assign('/member/');
    }
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = String(new FormData(form).get('email') || '').trim().toLowerCase();
    if (!email || !supabase) {
      if (!supabase) showNote('Supabase is not configured in this environment.', true);
      return;
    }

    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitButton) submitButton.disabled = true;
    showNote(isChangeEmail ? 'Sending the confirmation…' : 'Complete the security check to continue.');

    if (isChangeEmail) {
      const { data } = await supabase.auth.getSession();
      if (!data.session) {
        if (submitButton) submitButton.disabled = false;
        showNote('Sign in before changing the email address.', true);
        return;
      }
      const { error } = await supabase.auth.updateUser({ email });
      if (submitButton) submitButton.disabled = false;
      if (error) {
        showNote(error.message || 'We could not start the email change. Please try again.', true);
        return;
      }
      form.reset();
      showNote('Check the new address to confirm the change.');
      return;
    }
    if (!captchaWidget || !captchaStep) {
      if (submitButton) submitButton.disabled = false;
      showNote('The security check is not available. Please try again later.', true);
      return;
    }
    pendingEmail = email;
    fields?.classList.add('hidden');
    flowHelper?.classList.add('hidden');
    captchaStep?.classList.remove('hidden');
    window.setTimeout(renderCaptcha, 0);
  });
</script>
