</article>

<style>
  .mail-stage > .inbox-list,
  .mail-stage > .open-letter {
    grid-area: 1 / 1;
  }

  .mail-row,
  .incoming-row {
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
  }

  .unread-count {
    opacity: 1;
  }

  .letter-label {
    opacity: 1;
  }

  .inbox-label {
    opacity: 0;
  }

  .incoming-row {
    max-height: 4.75rem;
    overflow: hidden;
    opacity: 1;
  }

  .inbox-list {
    visibility: hidden;
    opacity: 0;
  }

  .open-letter {
    opacity: 1;
  }

  .mail-preview.is-animated .unread-count {
    opacity: 0;
    transform: translateY(-0.2rem);
  }

  .mail-preview.is-animated .letter-label {
    opacity: 0;
    transform: translateY(0.45rem);
  }

  .mail-preview.is-animated .inbox-label {
    opacity: 1;
  }

  .mail-preview.is-animated .incoming-row {
    max-height: 0;
    opacity: 0;
    transform: translateY(-0.75rem);
    border-color: transparent;
  }

  .mail-preview.is-animated .inbox-list {
    visibility: visible;
    opacity: 1;
  }

  .mail-preview.is-animated .open-letter {
    opacity: 0;
    transform: translateY(0.6rem);
  }

  .mail-preview.is-playing .unread-count {
    animation: reveal-unread 350ms ease-out 1.15s forwards;
  }

  .mail-preview.is-playing .letter-label {
    animation: reveal-label 400ms ease-out 3.05s forwards;
  }

  .mail-preview.is-playing .inbox-label {
    animation: hide-label 300ms ease-in 2.9s forwards;
  }

  .mail-preview.is-playing .incoming-row {
    animation: receive-mail 700ms cubic-bezier(0.22, 1, 0.36, 1) 750ms forwards;
  }

  .mail-preview.is-playing .inbox-list {
    animation: close-inbox 450ms ease-in 2.9s forwards;
  }

  .mail-preview.is-playing .open-letter {
    animation: open-message 550ms cubic-bezier(0.22, 1, 0.36, 1) 3.15s forwards;
  }

  @keyframes receive-mail {
    0% {
      max-height: 0;
      opacity: 0;
      transform: translateY(-0.75rem);
      border-color: transparent;
    }
    75% {
      max-height: 4.75rem;
      opacity: 1;
      transform: translateY(0);
      border-color: var(--border);
    }
    100% {
      max-height: 4.75rem;
      opacity: 1;
      transform: translateY(0);
      border-color: var(--border);
    }
  }

  @keyframes reveal-unread {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes close-inbox {
    to {
      opacity: 0;
      transform: translateY(-0.35rem);
      visibility: hidden;
    }
  }

  @keyframes open-message {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hide-label {
    to {
      opacity: 0;
      transform: translateY(-0.45rem);
    }
  }

  @keyframes reveal-label {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .unread-count,
    .letter-label,
    .inbox-label,
    .incoming-row,
    .inbox-list,
    .open-letter {
      animation: none;
    }

    .unread-count,
    .letter-label,
    .open-letter {
      opacity: 1;
      transform: none;
    }

    .inbox-label,
    .inbox-list {
      display: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>('[data-email-preview]:not([data-animation-ready])').forEach((preview) => {
      preview.dataset.animationReady = 'true';
      preview.classList.add('is-animated');

      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;

        observer.disconnect();
        requestAnimationFrame(() => preview.classList.add('is-playing'));
        window.setTimeout(() => preview.classList.remove('is-animated', 'is-playing'), 4000);
      }, { threshold: 0.35 });

      observer.observe(preview);
    });
  }
</script>
