---
interface Props {
  variant?: 'animated' | 'compose' | 'received';
}

const { variant = 'animated' } = Astro.props;
const isAnimated = variant === 'animated';
const letterCopy = 'Today I noticed how a small pause can change the shape of a whole morning…';
---

<article class="mail-preview overflow-hidden border border-border bg-surface shadow-[0_18px_45px_-36px_rgba(33,31,27,0.55)]" aria-label={variant === 'compose' ? 'Example of writing a letter from your inbox' : variant === 'received' ? 'Example of receiving a private letter' : 'Example of writing and receiving a letter by email'} data-email-preview={isAnimated ? true : undefined} data-email-variant={variant}>
  <div class="flex items-center justify-between border-b border-border bg-background/55 px-4 py-3 sm:px-5">
    <div class="flex items-center gap-3" aria-hidden="true">
      <span class="flex gap-1.5">
        <span class="h-2 w-2 rounded-full bg-border"></span>
        <span class="h-2 w-2 rounded-full bg-border"></span>
        <span class="h-2 w-2 rounded-full bg-border"></span>
      </span>
      <span class="h-4 border-l border-border"></span>
      <span class="text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-muted-foreground">Inbox</span>
    </div>
    <div class="unread-count flex items-center gap-2 text-[0.68rem] text-muted-foreground">
      <span>1 unread</span>
      <span class="h-2 w-2 rounded-full bg-accent" aria-label="Unread"></span>
    </div>
  </div>

  <div class="flex items-center justify-between border-b border-border px-4 py-2.5 text-muted-foreground sm:px-5" aria-label="Email actions">
    <span class="relative grid overflow-hidden">
      <span class="inbox-label eyebrow col-start-1 row-start-1">All mail</span>
      <span class="letter-label eyebrow col-start-1 row-start-1">Compose</span>
    </span>
    <div class="email-actions flex items-center gap-4" aria-hidden="true">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M4 7.5h16v12H4zM3 4.5h18v3H3zM9.5 11.5h5" />
      </svg>
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="m12 3 2.7 5.55 6.1.89-4.4 4.29 1.04 6.07L12 16.94 6.56 19.8l1.04-6.07-4.4-4.29 6.1-.89L12 3Z" />
      </svg>
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="m9 7-5 5 5 5M4 12h9a7 7 0 0 1 7 7" />
      </svg>
    </div>
  </div>

  <div class="mail-stage grid">
    <div class="compose-letter col-start-1 row-start-1 px-4 py-5 sm:px-7 sm:py-6">
      <div class="flex items-center justify-between border-b border-border pb-4">
        <div>
          <p class="eyebrow mb-1 text-accent">Write a letter</p>
          <p class="m-0 text-[0.7rem] text-muted-foreground">Plain text · private by design</p>
        </div>
        <span class="border border-border px-2 py-1 text-[0.62rem] uppercase tracking-[0.12em] text-muted-foreground">Draft</span>
      </div>
      <div class="mt-5 grid gap-3 text-[0.72rem]">
        <div class="flex gap-3 border-b border-border pb-3"><span class="text-muted-foreground">To:</span><span class="font-medium">write@getonereader.com</span></div>
        <p class="eyebrow pt-3 text-accent">Write</p>
        <p class="m-0 font-serif text-xl italic leading-8 text-foreground/85">Dear someone,</p>
        <p class="typed-letter m-0 max-w-md font-serif text-xl italic leading-8 text-foreground/85" aria-label={letterCopy}>{Array.from(letterCopy).map((character, index) => <span class="typed-character" data-typed-character data-character-index={index}>{character}</span>)}<span class="typing-caret" aria-hidden="true"></span></p>
      </div>
      <div class="mt-7 flex items-center justify-between border-t border-border pt-4 text-[0.7rem] text-muted-foreground">
        <span class="max-w-[15rem] leading-5">Your address stays private. They’ll never see your real address either.</span>
        <span class="send-control relative flex items-center border border-accent bg-accent px-4 py-2 text-primary-foreground"><span>Send</span><span class="send-ripple" aria-hidden="true"></span></span>
      </div>
    </div>

    <div class="sent-state col-start-1 row-start-1 px-4 py-5 sm:px-7 sm:py-6" aria-hidden="true">
      <div class="flex min-h-[15rem] flex-col items-center justify-center text-center">
        <span class="flex h-12 w-12 items-center justify-center rounded-full border border-accent text-xl text-accent">✓</span>
        <p class="eyebrow mt-5 mb-3 text-accent">Sent</p>
        <p class="m-0 max-w-xs font-serif text-2xl leading-tight">Somewhere, a stranger may be reading.</p>
        <p class="mt-4 max-w-xs text-sm leading-6 text-muted-foreground">And one day, a letter may find its way back to you.</p>
      </div>
    </div>

    <div class="inbox-list col-start-1 row-start-1" aria-hidden="true">
      <div class="incoming-row grid grid-cols-[2.25rem_1fr_auto] items-center gap-3 border-b border-border bg-accent/[0.055] px-4 sm:px-7">
        <span class="flex h-9 w-9 items-center justify-center rounded-full border border-accent/40 bg-surface font-serif text-sm italic text-accent">O</span>
        <span class="min-w-0 py-3">
          <span class="block truncate text-[0.76rem] font-semibold text-foreground">One Reader</span>
          <span class="block truncate text-[0.72rem] text-foreground/80">Dear someone, This morning the rain stopped…</span>
        </span>
        <span class="flex items-center gap-2 text-[0.65rem] text-muted-foreground">
          <span>9:14</span>
          <span class="h-2 w-2 rounded-full bg-accent"></span>
        </span>
      </div>

      <div class="mail-row grid grid-cols-[2.25rem_1fr_auto] items-center gap-3 border-b border-border px-4 py-3 sm:px-7">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-muted text-[0.68rem] font-medium text-muted-foreground">P</span>
        <span class="min-w-0">
          <span class="block truncate text-[0.74rem] font-medium text-foreground/75">Parcel</span>
          <span class="block truncate text-[0.7rem] text-muted-foreground">Your order is on its way</span>
        </span>
        <span class="text-[0.65rem] text-muted-foreground">8:42</span>
      </div>

      <div class="mail-row grid grid-cols-[2.25rem_1fr_auto] items-center gap-3 border-b border-border px-4 py-3 sm:px-7">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-muted text-[0.68rem] font-medium text-muted-foreground">S</span>
        <span class="min-w-0">
          <span class="block truncate text-[0.74rem] font-medium text-foreground/75">Studio Notes</span>
          <span class="block truncate text-[0.7rem] text-muted-foreground">Five tools for a calmer workday</span>
        </span>
        <span class="text-[0.65rem] text-muted-foreground">7:30</span>
      </div>

      <div class="mail-row grid grid-cols-[2.25rem_1fr_auto] items-center gap-3 border-b border-border px-4 py-3 sm:px-7">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-muted text-[0.68rem] font-medium text-muted-foreground">M</span>
        <span class="min-w-0">
          <span class="block truncate text-[0.74rem] font-medium text-foreground/75">Sunday Market</span>
          <span class="block truncate text-[0.7rem] text-muted-foreground">A little something: 20% off today</span>
        </span>
        <span class="text-[0.65rem] text-muted-foreground">Yesterday</span>
      </div>

      <p class="m-0 px-7 py-5 text-center text-[0.68rem] leading-5 text-muted-foreground">Between receipts, updates and offers,<br />something written only for you.</p>
    </div>

    <div class="open-letter col-start-1 row-start-1 px-4 py-5 sm:px-7 sm:py-6">
      <div class="grid grid-cols-[2.25rem_1fr] gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-full border border-border bg-background text-sm font-medium text-muted-foreground" aria-hidden="true">S</div>
        <div class="min-w-0">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="truncate text-[0.78rem] font-semibold leading-5 text-foreground">stranger·4f92@getonereader.com</p>
              <p class="text-[0.7rem] leading-4 text-muted-foreground">to you · private alias</p>
            </div>
            <time class="shrink-0 pt-0.5 text-[0.68rem] text-muted-foreground" datetime="2026-08-09T09:14:00+02:00">Today, 9:14</time>
          </div>
        </div>
      </div>

      <div class="ml-[3rem] mt-5 border-t border-border pt-5">
        <p class="m-0 font-serif text-xl italic leading-8 text-foreground/85">Dear someone,<br />This morning the rain stopped just before I left home. For a few minutes, every window on my street held the same pale light…</p>
      </div>

      <div class="ml-[3rem] mt-7 flex items-center gap-2 border-t border-border pt-4 text-[0.7rem] leading-5 text-muted-foreground">
        <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="5" y="10" width="14" height="10" rx="1" />
          <path d="M8 10V7a4 4 0 0 1 8 0v3" />
        </svg>
        <span>Your address stays private. Reply from your inbox.</span>
      </div>
    </div>
  </div>

  {isAnimated && <div class="mail-progress flex flex-col items-center gap-2 border-t border-border px-4 py-3" role="group" aria-label="Letter journey">
    <div class="flex items-center justify-center gap-2">
      <span class="mail-progress-dot h-2.5 w-2.5 rounded-full border border-accent bg-accent" data-frame-dot="1" aria-hidden="true"></span>
      <span class="mail-progress-dot h-2.5 w-2.5 rounded-full border border-accent" data-frame-dot="2" aria-hidden="true"></span>
      <span class="mail-progress-dot h-2.5 w-2.5 rounded-full border border-accent" data-frame-dot="3" aria-hidden="true"></span>
      <span class="mail-progress-dot h-2.5 w-2.5 rounded-full border border-accent" data-frame-dot="4" aria-hidden="true"></span>
    </div>
    <span class="font-serif text-sm italic text-muted-foreground" data-frame-caption>Write a letter</span>
    <span class="sr-only" aria-live="polite" data-frame-status>1 of 4: write to someone</span>
  </div>}
</article>

<style>
  .mail-stage > .inbox-list,
  .mail-stage > .open-letter {
    grid-area: 1 / 1;
  }

  .mail-row,
  .incoming-row {
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
  }

  .compose-letter {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .sent-state,
  .open-letter {
    opacity: 0;
    visibility: hidden;
  }

  .letter-label {
    opacity: 1;
  }

  .inbox-label {
    opacity: 0;
  }

  .unread-count {
    opacity: 0;
  }

  .incoming-row {
    max-height: 4.75rem;
    overflow: hidden;
    opacity: 1;
  }

  .inbox-list {
    visibility: hidden;
    opacity: 0;
  }

  .mail-preview[data-email-variant="compose"] .compose-letter {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .mail-preview[data-email-variant="compose"] .inbox-label,
  .mail-preview[data-email-variant="compose"] .inbox-list {
    opacity: 0;
    visibility: hidden;
  }

  .mail-preview[data-email-variant="compose"] .letter-label {
    opacity: 1;
  }

  .mail-preview[data-email-variant="compose"] .typed-letter {
    clip-path: none;
  }

  .mail-preview[data-email-variant="compose"] .typed-character {
    display: inline;
    opacity: 1;
  }

  .mail-preview[data-email-variant="compose"] .typing-caret,
  .mail-preview[data-email-variant="compose"] .send-ripple {
    display: none;
  }

  .mail-preview[data-email-variant="received"] .inbox-list,
  .mail-preview[data-email-variant="received"] .compose-letter,
  .mail-preview[data-email-variant="received"] .sent-state {
    opacity: 0;
    visibility: hidden;
  }

  .mail-preview[data-email-variant="received"] .open-letter {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .mail-preview[data-email-variant="received"] .unread-count {
    opacity: 1;
  }

  .mail-preview[data-email-variant="received"] .inbox-label {
    opacity: 1;
  }

  .mail-preview[data-email-variant="received"] .letter-label {
    opacity: 0;
  }

  .mail-preview[data-email-variant="compose"] .mail-progress,
  .mail-preview[data-email-variant="received"] .mail-progress {
    display: none;
  }

  .mail-progress-dot {
    transition: background-color 250ms ease, transform 250ms ease;
  }

  .mail-progress-dot[data-active="true"] {
    background-color: var(--accent);
    transform: scale(1.2);
  }

  .mail-progress-dot[data-active="false"] {
    background-color: transparent;
  }

  .typed-letter {
    white-space: pre-wrap;
  }

  .typed-character {
    display: none;
    opacity: 0;
    transition: opacity 80ms ease-out;
  }

  .typed-character.is-visible {
    display: inline;
    opacity: 1;
  }

  .typing-caret {
    display: inline-block;
    width: 0.08rem;
    height: 1.35rem;
    margin-left: 0.1rem;
    vertical-align: -0.22rem;
    background: var(--accent);
    opacity: 0;
  }

  .send-ripple {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 1.8rem;
    height: 1.8rem;
    border: 1px solid var(--accent);
    border-radius: 9999px;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.5);
  }

  .mail-preview.is-playing .inbox-list {
    animation: journey-inbox 22s ease-in-out infinite;
  }

  .mail-preview.is-playing .compose-letter {
    animation: journey-compose 22s ease-in-out infinite;
  }

  .mail-preview.is-playing .sent-state {
    animation: journey-sent 22s ease-in-out infinite;
  }

  .mail-preview.is-playing .unread-count {
    animation: journey-unread 22s ease-in-out infinite;
  }

  .mail-preview.is-playing .letter-label {
    animation: journey-letter-label 22s ease-in-out infinite;
  }

  .mail-preview.is-playing .inbox-label {
    animation: journey-inbox-label 22s ease-in-out infinite;
  }

  .mail-preview.is-playing .open-letter {
    animation: journey-open-letter 22s ease-in-out infinite;
  }

  .mail-preview.is-playing .typing-caret {
    animation: journey-caret 22s linear infinite;
  }

  .mail-preview.is-playing .send-control {
    animation: journey-send-press 22s ease-in-out infinite;
  }

  .mail-preview.is-playing .send-ripple {
    animation: journey-send-ripple 22s ease-out infinite;
  }

  .mail-preview.is-playing .email-actions {
    animation: journey-actions 22s ease-in-out infinite;
  }

  @keyframes journey-inbox {
    0%, 45% {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.35rem);
    }
    49%, 67% {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    72%, 100% {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.35rem);
    }
  }

  @keyframes journey-compose {
    0%, 17% {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    21%, 100% {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.6rem);
    }
  }

  @keyframes journey-sent {
    0%, 21% {
      opacity: 0;
      visibility: hidden;
      transform: translateY(0.45rem);
    }
    25%, 42% {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    47%, 100% {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.35rem);
    }
  }

  @keyframes journey-unread {
    0%, 45% {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
    49%, 100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes journey-letter-label {
    0%, 21% {
      opacity: 1;
      transform: translateY(0);
    }
    25%, 100% {
      opacity: 0;
      transform: translateY(-0.45rem);
    }
  }

  @keyframes journey-inbox-label {
    0%, 45% {
      opacity: 0;
      transform: translateY(-0.45rem);
    }
    49%, 100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes journey-open-letter {
    0%, 70% {
      opacity: 0;
      visibility: hidden;
      transform: translateY(0.6rem);
    }
    74%, 94% {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    98%, 100% {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.25rem);
    }
  }

  @keyframes journey-caret {
    0%, 2%, 17%, 21%, 100% {
      opacity: 0;
    }
    3%, 15% {
      opacity: 1;
    }
  }

  @keyframes journey-send-press {
    0%, 14% {
      transform: scale(1);
    }
    15% {
      transform: scale(0.94);
    }
    16%, 100% {
      transform: scale(1);
    }
  }

  @keyframes journey-send-ripple {
    0%, 14% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.5);
    }
    15% {
      opacity: 0.8;
      transform: translate(-50%, -50%) scale(0.8);
    }
    20%, 100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1.7);
    }
  }

  @keyframes journey-actions {
    0%, 21% {
      opacity: 1;
      visibility: visible;
    }
    25%, 70% {
      opacity: 0;
      visibility: hidden;
    }
    74%, 100% {
      opacity: 1;
      visibility: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mail-progress {
      display: none;
    }

    .unread-count,
    .letter-label,
    .inbox-label,
    .incoming-row,
    .inbox-list,
    .open-letter,
    .compose-letter,
    .sent-state {
      animation: none;
    }

    .compose-letter {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .sent-state,
    .open-letter,
    .inbox-list {
      display: none;
    }

    .inbox-label,
    .unread-count {
      opacity: 0;
      visibility: hidden;
    }

    .letter-label {
      opacity: 1;
    }

    .typed-letter {
      clip-path: none;
    }

    .typed-character {
      display: inline;
      opacity: 1;
    }

    .typing-caret,
    .send-ripple {
      display: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const journeyDuration = 22000;
  const frameOffsets = [0, 5500, 10800, 16300];
  const frameLabels = ['Write to someone', 'On its way', 'Between the noise', 'A letter for you'];

  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>('[data-email-preview]:not([data-animation-ready])').forEach((preview) => {
      preview.dataset.animationReady = 'true';
      const dots = Array.from(preview.querySelectorAll<HTMLElement>('[data-frame-dot]'));
      const typedCharacters = Array.from(preview.querySelectorAll<HTMLElement>('[data-typed-character]'));
      const frameStatus = preview.querySelector<HTMLElement>('[data-frame-status]');
      const frameCaption = preview.querySelector<HTMLElement>('[data-frame-caption]');
      let frameTimers: number[] = [];
      let cycleTimer: number | undefined;

      const setFrame = (frame: number) => {
        dots.forEach((dot) => dot.dataset.active = dot.dataset.frameDot === String(frame) ? 'true' : 'false');
        if (frameStatus) frameStatus.textContent = `${frame} of 4: ${frameLabels[frame - 1]}`;
        if (frameCaption) frameCaption.textContent = frameLabels[frame - 1];
      };

      const resetTyping = () => typedCharacters.forEach((character) => character.classList.remove('is-visible'));

      const clearCycle = () => {
        frameTimers.forEach((timer) => window.clearTimeout(timer));
        frameTimers = [];
        if (cycleTimer !== undefined) window.clearTimeout(cycleTimer);
        cycleTimer = undefined;
        resetTyping();
      };

      const scheduleCycle = () => {
        clearCycle();
        setFrame(1);
        typedCharacters.forEach((character, index) => {
          frameTimers.push(window.setTimeout(() => character.classList.add('is-visible'), 180 + index * 24));
        });
        frameOffsets.slice(1).forEach((offset, index) => {
          frameTimers.push(window.setTimeout(() => setFrame(index + 2), offset));
        });
        cycleTimer = window.setTimeout(scheduleCycle, journeyDuration);
      };

      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          preview.classList.add('is-playing');
          scheduleCycle();
        } else {
          preview.classList.remove('is-playing');
          clearCycle();
          setFrame(1);
        }
      }, { threshold: 0.35 });

      setFrame(1);
      observer.observe(preview);
    });
  }
</script>
