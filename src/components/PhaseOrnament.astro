---
interface Props {
  phase: 'write' | 'receive';
}

const { phase } = Astro.props;
---

<div class="phase-ornament hidden items-center justify-center lg:flex" data-phase-ornament={phase} aria-hidden="true">
  {phase === 'write' ? (
    <svg class="h-auto w-full max-w-sm text-accent/60" viewBox="0 0 320 190" fill="none" data-phase-svg="write">
      <defs>
        <g id="write-ghost-person">
          <circle cx="18" cy="12" r="7" />
          <path d="M11 11c0-5 3-8 7-8s7 3 7 8" />
          <path d="M12 19c2-2 10-2 12 0 4 3 6 9 7 16m-27 0c1-7 3-13 8-16m-8 16v24h28V35m-22-2-6 18m20-18 6 18" stroke-linecap="round" />
        </g>
        <g id="write-short-person">
          <circle cx="18" cy="12" r="8" fill="currentColor" />
          <path d="M9 11c0-7 4-11 9-11s9 4 9 11c-4-3-6-4-9-4s-5 1-9 4Z" fill="currentColor" />
          <path d="M12 19c2-2 10-2 12 0 5 3 7 9 8 16l-4 1v25H8V36l-4-1c1-7 3-13 8-16Z" fill="currentColor" />
        </g>
        <g id="write-curly-person">
          <circle cx="18" cy="12" r="8" fill="currentColor" />
          <path d="M9 11c0-7 4-11 9-11s9 4 9 11l-3-3-3 3-3-3-3 3-3-3Z" fill="currentColor" />
          <path d="M12 19c2-2 10-2 12 0 5 3 7 9 8 16l-4 1v25H8V36l-4-1c1-7 3-13 8-16Z" fill="currentColor" />
        </g>
        <g id="write-long-person">
          <circle cx="18" cy="12" r="8" fill="currentColor" />
          <path d="M9 15C5 4 10-1 18-1s13 6 10 17l-4 6V9c-3 2-8 2-12 0v14l-3-5Z" fill="currentColor" />
          <path d="M12 19c2-2 10-2 12 0 5 3 7 9 8 16l-4 1v25H8V36l-4-1c1-7 3-13 8-16Z" fill="currentColor" />
        </g>
        <g id="write-bun-person">
          <circle cx="18" cy="12" r="8" fill="currentColor" />
          <circle cx="28" cy="2" r="5" fill="currentColor" />
          <path d="M9 11c0-7 4-11 9-11s9 4 9 11c-4-3-6-4-9-4s-5 1-9 4Z" fill="currentColor" />
          <path d="M12 19c2-2 10-2 12 0 5 3 7 9 8 16l-4 1v25H8V36l-4-1c1-7 3-13 8-16Z" fill="currentColor" />
        </g>
      </defs>

      <g stroke="currentColor" stroke-width="1" opacity="0.58">
        <use href="#write-ghost-person" transform="translate(76 10)" />
        <use href="#write-ghost-person" transform="translate(116 0)" />
        <use href="#write-ghost-person" transform="translate(158 18)" />
        <use href="#write-ghost-person" transform="translate(202 2)" />
        <use href="#write-ghost-person" transform="translate(246 20)" />
        <use href="#write-ghost-person" transform="translate(104 91)" />
        <use href="#write-ghost-person" transform="translate(151 104)" />
        <use href="#write-ghost-person" transform="translate(204 89)" />
        <use href="#write-ghost-person" transform="translate(250 102)" />
      </g>

      <g class="ornament-variant" data-ornament-variant="1">
        <path d="M42 132C67 132 78 82 112 82s37 56 70 56 28-72 64-72 45 39 50 39" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-dasharray="2 8" />
        <use href="#write-curly-person" transform="translate(18 94) scale(1.25)" fill="currentColor" stroke="none" />
        <use href="#write-short-person" transform="translate(267 62) scale(1.12)" fill="currentColor" stroke="none" />
      </g>
      <g class="ornament-variant" data-ornament-variant="2">
        <path d="M44 129C74 129 77 58 121 58s33 83 72 83 34-59 64-59 39 26 48 26" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-dasharray="2 8" />
        <use href="#write-short-person" transform="translate(20 92) scale(1.25)" fill="currentColor" stroke="none" />
        <use href="#write-long-person" transform="translate(267 64) scale(1.12)" fill="currentColor" stroke="none" />
      </g>
      <g class="ornament-variant" data-ornament-variant="3">
        <path d="M40 133C72 133 79 96 113 96s38 36 72 36 29-84 63-84 48 53 56 53" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-dasharray="2 8" />
        <use href="#write-long-person" transform="translate(19 92) scale(1.25)" fill="currentColor" stroke="none" />
        <use href="#write-bun-person" transform="translate(266 61) scale(1.12)" fill="currentColor" stroke="none" />
      </g>
      <g class="ornament-variant" data-ornament-variant="4">
        <path d="M43 132C76 132 82 71 116 71s35 68 74 68 30-69 64-69 41 38 49 38" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-dasharray="2 8" />
        <use href="#write-bun-person" transform="translate(20 94) scale(1.25)" fill="currentColor" stroke="none" />
        <use href="#write-curly-person" transform="translate(267 64) scale(1.12)" fill="currentColor" stroke="none" />
      </g>
    </svg>
  ) : (
    <svg class="h-auto w-full max-w-sm text-accent/60" viewBox="0 0 320 190" fill="none" data-phase-svg="receive">
      <defs>
        <g id="receive-ghost-person">
          <circle cx="18" cy="12" r="7" />
          <path d="M11 11c0-5 3-8 7-8s7 3 7 8" />
          <path d="M12 19c2-2 10-2 12 0 4 3 6 9 7 16m-27 0c1-7 3-13 8-16m-8 16v24h28V35m-22-2-6 18m20-18 6 18" stroke-linecap="round" />
        </g>
        <g id="receive-short-person">
          <circle cx="18" cy="12" r="8" fill="currentColor" />
          <path d="M9 11c0-7 4-11 9-11s9 4 9 11c-4-3-6-4-9-4s-5 1-9 4Z" fill="currentColor" />
          <path d="M12 19c2-2 10-2 12 0 5 3 7 9 8 16l-4 1v25H8V36l-4-1c1-7 3-13 8-16Z" fill="currentColor" />
        </g>
        <g id="receive-curly-person">
          <circle cx="18" cy="12" r="8" fill="currentColor" />
          <path d="M9 11c0-7 4-11 9-11s9 4 9 11l-3-3-3 3-3-3-3 3-3-3Z" fill="currentColor" />
          <path d="M12 19c2-2 10-2 12 0 5 3 7 9 8 16l-4 1v25H8V36l-4-1c1-7 3-13 8-16Z" fill="currentColor" />
        </g>
        <g id="receive-long-person">
          <circle cx="18" cy="12" r="8" fill="currentColor" />
          <path d="M9 15C5 4 10-1 18-1s13 6 10 17l-4 6V9c-3 2-8 2-12 0v14l-3-5Z" fill="currentColor" />
          <path d="M12 19c2-2 10-2 12 0 5 3 7 9 8 16l-4 1v25H8V36l-4-1c1-7 3-13 8-16Z" fill="currentColor" />
        </g>
        <g id="receive-bun-person">
          <circle cx="18" cy="12" r="8" fill="currentColor" />
          <circle cx="28" cy="2" r="5" fill="currentColor" />
          <path d="M9 11c0-7 4-11 9-11s9 4 9 11c-4-3-6-4-9-4s-5 1-9 4Z" fill="currentColor" />
          <path d="M12 19c2-2 10-2 12 0 5 3 7 9 8 16l-4 1v25H8V36l-4-1c1-7 3-13 8-16Z" fill="currentColor" />
        </g>
      </defs>

      <g stroke="currentColor" stroke-width="1" opacity="0.52">
        <use href="#receive-ghost-person" transform="translate(70 12)" />
        <use href="#receive-ghost-person" transform="translate(116 2)" />
        <use href="#receive-ghost-person" transform="translate(166 18)" />
        <use href="#receive-ghost-person" transform="translate(218 6)" />
        <use href="#receive-ghost-person" transform="translate(102 103)" />
        <use href="#receive-ghost-person" transform="translate(156 91)" />
        <use href="#receive-ghost-person" transform="translate(210 104)" />
      </g>

      <g class="ornament-variant" data-ornament-variant="1">
        <path d="M24 72C61 72 74 127 112 127s34-74 72-74 44 63 81 63" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-dasharray="2 8" />
        <use href="#receive-short-person" transform="translate(21 42) scale(1.12)" fill="currentColor" stroke="none" />
        <use href="#receive-curly-person" transform="translate(254 93) scale(1.25)" fill="currentColor" stroke="none" />
      </g>
      <g class="ornament-variant" data-ornament-variant="2">
        <path d="M24 64C60 64 71 115 109 115s38-65 73-65 40 73 89 73" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-dasharray="2 8" />
        <use href="#receive-long-person" transform="translate(21 35) scale(1.12)" fill="currentColor" stroke="none" />
        <use href="#receive-short-person" transform="translate(253 89) scale(1.25)" fill="currentColor" stroke="none" />
      </g>
      <g class="ornament-variant" data-ornament-variant="3">
        <path d="M25 83C60 83 78 139 113 139s28-84 70-84 40 57 88 57" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-dasharray="2 8" />
        <use href="#receive-bun-person" transform="translate(20 54) scale(1.12)" fill="currentColor" stroke="none" />
        <use href="#receive-long-person" transform="translate(253 88) scale(1.25)" fill="currentColor" stroke="none" />
      </g>
      <g class="ornament-variant" data-ornament-variant="4">
        <path d="M25 70C58 70 76 126 110 126s37-76 74-76 44 67 87 67" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-dasharray="2 8" />
        <use href="#receive-curly-person" transform="translate(20 45) scale(1.12)" fill="currentColor" stroke="none" />
        <use href="#receive-bun-person" transform="translate(253 91) scale(1.25)" fill="currentColor" stroke="none" />
      </g>
    </svg>
  )}
</div>

<style>
  .phase-ornament .ornament-variant {
    opacity: 0;
    visibility: hidden;
  }

  .phase-ornament .ornament-variant[data-selected="true"] {
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-phase-ornament]:not([data-ornament-ready])').forEach((ornament) => {
    ornament.dataset.ornamentReady = 'true';
    const variants = Array.from(ornament.querySelectorAll<SVGGElement>('[data-ornament-variant]'));
    if (!variants.length) return;
    variants.forEach((variant) => variant.dataset.selected = 'false');
    const selected = variants[Math.floor(Math.random() * variants.length)];
    selected.dataset.selected = 'true';
  });
</script>
